#!/bin/sh
# Auto-bump version.json before every commit (API + Android read this file).
# Skip once: SKIP_VERSION_BUMP=1 git commit ...
# Enable hooks: scripts/setup-git-hooks.ps1

if [ "$SKIP_VERSION_BUMP" = "1" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 || exit 1
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bump-version.ps1 || exit 1
else
  echo "pre-commit: need PowerShell to run scripts/bump-version.ps1" >&2
  exit 1
fi

git add version.json \
  services/api/WfhDiary.Api/AppVersion.cs \
  services/api/WfhDiary.Api/WfhDiary.Api.csproj

exit 0
