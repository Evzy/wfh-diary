    <string name="settings_info_morning_reminder_title">Morning reminder</string>
    <string name="settings_info_morning_reminder_message">Posts a notification at your chosen time on working days. Tap Home, Office, or Leave to log the day. Skipped on leave days and when geolocation silent skip already logged the day.</string>
    <string name="settings_info_missed_response_title">If you don\u2019t respond</string>
    <string name="settings_info_missed_response_message">If you ignore the morning reminder, the app can auto-log at the apply time below.\n\n\u2022 None \u2014 no auto-log\n\u2022 Home / Office / Leave \u2014 always log that choice\n\u2022 Geolocation \u2014 check where you are at reminder and apply times (see Location settings)\n\nIf you already logged the day (from the notification or calendar), nothing is overwritten.</string>
    <string name="settings_info_apply_at_title">Apply default at</string>
    <string name="settings_info_apply_at_message">When the morning reminder gets no response, the app waits until this time then auto-logs. With geolocation, your location is checked at this moment\u2014not tracked all day. You receive a notification confirming what was logged.</string>
    <string name="settings_info_geolocation_title">Geolocation mode</string>
    <string name="settings_info_geolocation_message">At your morning reminder time and at the apply time, the app checks whether you are inside your home or office area. It does not track you throughout the day.\n\nIf inside home \u2192 Home preset. If inside office \u2192 Office preset. If neither \u2192 your away fallback.</string>
    <string name="settings_info_away_fallback_title">When away from home and office</string>
    <string name="settings_info_away_fallback_message">Used when geolocation mode runs but you are not inside either area at check time. Example: you are at a caf\u00e9 and away fallback is Office \u2192 logs Office at apply time.</string>
    <string name="settings_info_skip_notification_title">Skip morning reminder</string>
    <string name="settings_info_skip_notification_message">At morning reminder time, if you are inside the matching area and the day is not logged yet, the app logs silently\u2014no notification. The apply-time job is skipped because the day is already done.\n\nTurn off to always receive the morning reminder even when at home or office.</string>
    <string name="settings_info_geofence_areas_title">Home and office areas</string>
    <string name="settings_info_geofence_areas_message">Circular areas on the map. At reminder and apply times only, the app checks whether your current location falls inside. Being nearby for other reasons counts if you are inside the circle at check time.</string>
    <string name="settings_info_presets_title">Home &amp; office presets</string>
    <string name="settings_info_presets_message">Default start, finish, and break times used when you log Home or Office\u2014from the notification, geolocation, or auto-log at apply time.</string>
    <string name="settings_info_location_permission_title">Location permission</string>
    <string name="settings_info_location_permission_message">Location is read only at your morning reminder and apply times\u2014not continuously. Allow all the time so checks work when the app is closed (e.g. the 12\u202fpm auto-log).</string>
    <string name="settings_missed_notification_title">If you don\u2019t respond</string>
    <string name="settings_missed_notification_hint">On a working day, if you do not tap Home, Office, or Leave on the morning reminder, the app can apply a default at the time below.</string>
    <string name="settings_missed_notification_apply_at">Apply default at</string>
